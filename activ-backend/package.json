{
    "name": "activ-backend",
    "version": "1.0.0",
    "description": "Backend API for ACTIV member management system",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "stop": "taskkill /F /IM node.exe",
        "restart": "npm run stop && npm run dev",
        "restart:dev": "npm run stop && npm run dev",
        "test": "echo \"Error: no test specified\" && exit 1",
        "load-test": "node test/load-test.js",
        "benchmark": "node test/load-test.js",
        "optimize": "node run-optimization.js",
        "setup": "node setup-complete-optimization.js"
    },
    "keywords": [
        "activ",
        "member",
        "management",
        "api"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "axios": "^1.13.2",
        "bcryptjs": "^2.4.3",
        "compression": "^1.8.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "express-validator": "^7.3.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.0.3",
        "node-cache": "^5.1.2",
        "redis": "^5.10.0"
    },
    "devDependencies": {
        "nodemon": "^3.1.11",
        "pm2": "^6.0.14"
    }
}
